# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────
# MongoDB Atlas connection string. NEVER commit the real value.
# Example (Atlas):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ams-store?retryWrites=true&w=majority
MONGODB_URI=

# ─── Auth ─────────────────────────────────────────────────
# Use a long random string: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─── Admin (used only by the seed script) ─────────────────
ADMIN_NAME=Store Owner
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ─── Store defaults (used only by the seed script) ────────
STORE_NAME="Pakistani Ladies Suits"
STORE_WHATSAPP=923001234567
STORE_CURRENCY=PKR

# ─── CORS (comma separated origins, * for all) ────────────
CORS_ORIGIN=*